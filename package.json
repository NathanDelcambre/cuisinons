{
  "name": "cuisinons",
  "version": "0.1.0",
  "private": true,
  "description": "Cuisinons — application privée de recettes, planning et nutrition",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.11.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@cuisinons/web --filter=@cuisinons/api",
    "dev:web": "pnpm --filter @cuisinons/web dev",
    "dev:api": "pnpm --filter @cuisinons/api dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @cuisinons/web test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml,css}\"",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @cuisinons/db migrate:dev",
    "db:migrate:deploy": "pnpm --filter @cuisinons/db migrate:deploy",
    "db:seed": "pnpm --filter @cuisinons/db seed",
    "db:import-ciqual": "pnpm --filter @cuisinons/db import-ciqual",
    "auth:bootstrap": "pnpm --filter @cuisinons/db auth:bootstrap",
    "db:generate": "pnpm --filter @cuisinons/db generate"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["argon2", "prisma", "@prisma/engines", "esbuild"]
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript": "^5.8.2"
  }
}
