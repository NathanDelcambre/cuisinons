# Copier vers .env (jamais commité) puis vers apps/web/.env.local et apps/api/.env

NODE_ENV=development
APP_ENV=development

# PostgreSQL local (docker compose)
DATABASE_URL=postgresql://cuisinons:cuisinons@localhost:55432/cuisinons
DIRECT_URL=postgresql://cuisinons:cuisinons@localhost:55432/cuisinons

# Secrets (>= 32 caractères en production)
AUTH_SECRET=dev-auth-secret-change-me-32-chars-min
PASSWORD_PEPPER=dev-password-pepper-change-me-32ch
INTERNAL_API_SECRET=dev-internal-api-secret-32chars-min

SESSION_TTL_DAYS=7
INTERNAL_JWT_TTL_SECONDS=45

# Google OAuth (laisser vide pour désactiver)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Origines
PORT=3601
API_BASE_URL=http://localhost:3601
NEXT_PUBLIC_APP_URL=http://localhost:3600
WEB_ORIGIN=http://localhost:3600

# Cookies (false en HTTP local)
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_NAME_SESSION=cuisinons_session
CSRF_COOKIE_NAME=cuisinons_csrf

# Seed / bootstrap uniquement en local (ne jamais committer les vraies valeurs)
SEED_NATHAN_PASSWORD=
SEED_JADE_PASSWORD=

# Playwright (apps/web/.env.local)
E2E_NATHAN_PASSWORD=
