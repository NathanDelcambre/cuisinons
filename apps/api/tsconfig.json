{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "types": ["node"],
    "strictPropertyInitialization": false
  },
  "include": ["src", "tests", "api"]
}
