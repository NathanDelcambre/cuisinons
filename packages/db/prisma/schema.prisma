generator client {
  provider = "prisma-client-js"
  // Hors de src/ et à la même profondeur que dist/ : l'import relatif
  // '../generated/client' résout donc aussi bien depuis les sources que depuis dist.
  output   = "../generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum MealSlot {
  BREAKFAST
  LUNCH
  SNACK
  DINNER
}

/// Occupant d'un creneau sans recette cuisinee a la maison.
enum MealKind {
  RECIPE
  SKIPPED
  RESTAURANT
  IMPOSED
}

enum NutrientGoalMode {
  AT_LEAST
  AT_MOST
  TARGET
  NONE
}

enum QuantityUnit {
  G
  KG
  ML
  CL
  L
  TSP
  TBSP
  PIECE
  PINCH
  SLICE
  SACHET
  JAR
  CUSTOM
}

enum NutrientValueKind {
  VALUE
  TRACES
  LESS_THAN
  ABSENT
  NA
}

enum RecipeStatus {
  DRAFT
  PUBLISHED
}

/// USER : fiche créée dans l’app. CATALOG : recette de la maison, semée
/// une fois pour toutes. Healthy, sauces, bowls… ce sont des tags, pas
/// des tables à part.
enum RecipeSource {
  USER
  CATALOG
}

/// Zone de rangement d'un ingredient en stock. FRIDGE, PANTRY et OTHER se
/// deduisent de la categorie de l'ingredient ; FREEZER et BREAKFAST relevent
/// d'un choix personnel et ne sont donc jamais attribues automatiquement.
enum StorageArea {
  FRIDGE
  FREEZER
  PANTRY
  BREAKFAST
  OTHER
}

enum ShoppingItemOrigin {
  PLANNER
  MANUAL
}

/// Enseignes prises en charge par la résolution Open Prices.
enum Retailer {
  LECLERC
  U
  CARREFOUR
  AUCHAN
  LIDL
  INTERMARCHE
}

/// Provenance de la ligne achetable. Ciqual reste le filet de sécurité lorsque
/// Open Food Facts / Open Prices ne fournit pas de produit exploitable.
enum ProductDataSource {
  OPEN_FOOD_FACTS
  CIQUAL_FALLBACK
}

enum UxCategory {
  VEGETABLES
  FRUITS
  STARCHES
  CEREALS
  LEGUMES
  MEATS
  FISH
  SEAFOOD
  CHARCUTERIE
  EGGS
  CHEESES
  DAIRY
  FATS
  NUTS_SEEDS
  SPICES
  AROMATICS
  SAUCES
  CONDIMENTS
  PREPARATIONS
  BAKERY
  PASTRY
  SUGARS
  BEVERAGES
  VEGETARIAN_PRODUCTS
  PROCESSED
  OTHER
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  displayName       String
  passwordHash      String?
  googleSub         String?   @unique
  passwordChangedAt DateTime?
  heightCm          Decimal?  @db.Decimal(5, 1)
  weightKg          Decimal?  @db.Decimal(5, 1)
  targetWeightKg    Decimal?  @db.Decimal(5, 1)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  sessions               Session[]
  recipesCreated         Recipe[]                     @relation("RecipeAuthor")
  ratings                RecipeRating[]
  portions               MealParticipantPortion[]
  nutritionGoal          NutritionGoal?
  dailyOverrides         DailyNutritionGoalOverride[]
  optimizationPreference OptimizationPreference?
  optimizationUndo       OptimizationUndoSnapshot?
  ingredientFavorites    UserIngredientFavorite[]
  ingredientRecents      UserIngredientRecent[]
  createdMealItems       MealItem[]                   @relation("MealItemAuthor")
  pantryItems            PantryItem[]
  shoppingLists          ShoppingList[]
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

model Ingredient {
  id              String     @id @default(cuid())
  ciqualCode      Int        @unique
  nameFr          String
  nameNormalized  String
  groupName       String
  subGroupName    String?
  subSubGroupName String?
  uxCategory      UxCategory
  uxSubCategory   String

  energyKcalKind NutrientValueKind
  energyKcal     Decimal?          @db.Decimal(12, 4)
  proteinKind    NutrientValueKind
  proteinG       Decimal?          @db.Decimal(12, 4)
  carbKind       NutrientValueKind
  carbG          Decimal?          @db.Decimal(12, 4)
  fatKind        NutrientValueKind
  fatG           Decimal?          @db.Decimal(12, 4)
  fiberKind      NutrientValueKind
  fiberG         Decimal?          @db.Decimal(12, 4)
  sugarKind      NutrientValueKind
  sugarG         Decimal?          @db.Decimal(12, 4)
  saltKind       NutrientValueKind
  saltG          Decimal?          @db.Decimal(12, 4)

  source          String   @default("Ciqual")
  sourceVersion   String   @default("2025")
  sourceDate      DateTime
  iconSlug        String?
  iconUrl         String?
  iconSource      String?
  iconAttribution String?
  dedicatedIcon   Boolean  @default(false)

  conversions         IngredientConversion[]
  recipeIngredients   RecipeIngredient[]
  mealItemIngredients MealItemIngredient[]
  favorites           UserIngredientFavorite[]
  recents             UserIngredientRecent[]
  pantryItems         PantryItem[]
  shoppingItems       ShoppingListItem[]

  @@index([nameNormalized])
  @@index([uxCategory])
  @@index([nameFr])
}

model IngredientConversion {
  id           String       @id @default(cuid())
  ingredientId String
  ingredient   Ingredient   @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  unit         QuantityUnit
  gramsPerUnit Decimal      @db.Decimal(12, 4)
  source       String
  confidence   String
  createdAt    DateTime     @default(now())

  @@unique([ingredientId, unit])
}

model Recipe {
  id                String       @id @default(cuid())
  name              String
  description       String?
  status            RecipeStatus @default(DRAFT)
  source            RecipeSource @default(USER)
  authorId          String
  author            User         @relation("RecipeAuthor", fields: [authorId], references: [id])
  servings          Decimal      @db.Decimal(8, 2)
  prepTimeMinutes   Int?
  cookTimeMinutes   Int?
  photoUrl          String?
  finalCookedWeight Decimal?     @db.Decimal(12, 4)
  /**
   * Macros dénormalisées : les listes ne joignent plus les ingrédients Ciqual.
   */
  nutritionSnapshot Json?
  version           Int          @default(1)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  ingredients RecipeIngredient[]
  steps       RecipeStep[]
  tags        RecipeTag[]
  equipment   RecipeEquipment[]
  ratings     RecipeRating[]
  mealItems   MealItem[]

  @@index([name])
  @@index([authorId])
  @@index([updatedAt])
  @@index([status])
  @@index([source])
}

model RecipeIngredient {
  id              String       @id @default(cuid())
  recipeId        String
  recipe          Recipe       @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientId    String
  ingredient      Ingredient   @relation(fields: [ingredientId], references: [id])
  quantity        Decimal      @db.Decimal(12, 4)
  unit            QuantityUnit
  grams           Decimal?     @db.Decimal(12, 4)
  gramsManual     Boolean      @default(false)
  displayQuantity String?
  sortOrder       Int
  estimated       Boolean      @default(false)

  @@index([recipeId])
}

model RecipeStep {
  id              String @id @default(cuid())
  recipeId        String
  recipe          Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  stepNumber      Int
  description     String
  durationMinutes Int?

  @@index([recipeId])
}

model Tag {
  id      String      @id @default(cuid())
  slug    String      @unique
  label   String
  recipes RecipeTag[]
}

model RecipeTag {
  recipeId String
  tagId    String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([recipeId, tagId])
  @@index([tagId])
}

model Equipment {
  id       String            @id @default(cuid())
  slug     String            @unique
  label    String
  iconSlug String?
  recipes  RecipeEquipment[]
}

model RecipeEquipment {
  recipeId    String
  equipmentId String
  recipe      Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@id([recipeId, equipmentId])
}

model RecipeRating {
  id        String   @id @default(cuid())
  recipeId  String
  userId    String
  stars     Int
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([recipeId, userId])
}

model MealItem {
  id                String                   @id @default(cuid())
  date              DateTime                 @db.Date
  slot              MealSlot
  kind              MealKind                 @default(RECIPE)
  recipeId          String?
  recipe            Recipe?                  @relation(fields: [recipeId], references: [id])
  sortOrder         Int                      @default(0)
  version           Int                      @default(1)
  createdById       String
  createdBy         User                     @relation("MealItemAuthor", fields: [createdById], references: [id])
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  portions          MealParticipantPortion[]
  manualIngredients MealItemIngredient[]

  @@index([date, slot])
  @@index([recipeId])
}

/// Ingrédients saisis directement dans le planning, sans créer de recette.
/// Les quantités sont exprimées pour une portion du repas.
model MealItemIngredient {
  id           String       @id @default(cuid())
  mealItemId   String
  mealItem     MealItem     @relation(fields: [mealItemId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient   @relation(fields: [ingredientId], references: [id])
  quantity     Decimal      @db.Decimal(12, 4)
  unit         QuantityUnit
  grams        Decimal?     @db.Decimal(12, 4)
  sortOrder    Int

  @@index([mealItemId, sortOrder])
  @@index([ingredientId])
}

model MealParticipantPortion {
  id                 String              @id @default(cuid())
  mealItemId         String
  mealItem           MealItem            @relation(fields: [mealItemId], references: [id], onDelete: Cascade)
  userId             String
  user               User                @relation(fields: [userId], references: [id])
  portions           Decimal             @db.Decimal(8, 3)
  /// Horodate la consommation de cette portion. Sert de garde-fou : le stock
  /// n'est deduit qu'une fois, et le retour en arriere le recredite.
  consumedAt         DateTime?
  /// L'utilisateur a refuse la validation automatique d'un jour passe :
  /// on ne re-deduit pas le stock a la prochaine ouverture du planning.
  skipAutoConsume    Boolean             @default(false)
  pantryConsumptions PantryConsumption[]

  @@unique([mealItemId, userId])
  @@index([userId, consumedAt])
}

/// Stock personnel. Volontairement non partage entre les deux comptes : chacun
/// gere ses propres provisions, comme ses propres courses.
model PantryItem {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Passerelle vers SIQUAL, utilisée uniquement pour déduire les recettes.
  ingredientId   String
  ingredient     Ingredient      @relation(fields: [ingredientId], references: [id])
  productBarcode String
  product        OpenFoodProduct @relation(fields: [productBarcode], references: [barcode], onDelete: Restrict)
  area           StorageArea
  /// Quantité réellement restante, dans l'unité métrique du produit.
  quantity       Decimal         @db.Decimal(12, 4)
  unit           QuantityUnit
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([userId, productBarcode])
  @@index([userId, ingredientId, unit])
  @@index([userId, area])
}

/// Journal exact des produits débités par un repas. Il permet d'annuler une
/// consommation sans recréditer un autre produit du même ingrédient SIQUAL.
model PantryConsumption {
  id             String                 @id @default(cuid())
  portionId      String
  portion        MealParticipantPortion @relation(fields: [portionId], references: [id], onDelete: Cascade)
  productBarcode String
  product        OpenFoodProduct        @relation(fields: [productBarcode], references: [barcode], onDelete: Restrict)
  ingredientId   String
  area           StorageArea
  quantity       Decimal                @db.Decimal(12, 4)
  unit           QuantityUnit
  createdAt      DateTime               @default(now())

  @@unique([portionId, productBarcode])
  @@index([portionId])
}

/// Une liste de courses en cours par utilisateur. `completedAt` la cloture au
/// moment ou les achats basculent dans le stock, ce qui en conserve l'historique.
model ShoppingList {
  id          String             @id @default(cuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromDate    DateTime?          @db.Date
  toDate      DateTime?          @db.Date
  createdAt   DateTime           @default(now())
  completedAt DateTime?
  retailer    Retailer?
  economical  Boolean            @default(true)
  items       ShoppingListItem[]

  @@index([userId, completedAt])
}

model ShoppingListItem {
  id              String             @id @default(cuid())
  listId          String
  list            ShoppingList       @relation(fields: [listId], references: [id], onDelete: Cascade)
  ingredientId    String
  ingredient      Ingredient         @relation(fields: [ingredientId], references: [id])
  quantity        Decimal            @db.Decimal(12, 4)
  /// Besoin net du planning. `quantity` est la quantité réellement achetée,
  /// arrondie au nombre de paquets du produit sélectionné.
  neededQuantity  Decimal?           @db.Decimal(12, 4)
  unit            QuantityUnit
  origin          ShoppingItemOrigin @default(PLANNER)
  dataSource      ProductDataSource  @default(CIQUAL_FALLBACK)
  productBarcode  String?
  productName     String?
  productBrand    String?
  productImageUrl String?
  packageQuantity Decimal?           @db.Decimal(12, 4)
  packageCount    Int?
  estimatedPrice  Decimal?           @db.Decimal(10, 2)
  currency        String?
  priceObservedAt DateTime?
  storeName       String?
  economyNote     String?
  checked         Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([listId, ingredientId, unit])
}

/// Projection locale et volontairement bornee du dump Open Food Facts. Le
/// serveur applicatif ne contacte jamais Open Food Facts pendant une requete.
model OpenFoodProduct {
  barcode            String              @id
  name               String
  normalizedName     String
  searchText         String
  brand              String?
  imageUrl           String?
  packageQuantity    Decimal?            @db.Decimal(12, 4)
  packageUnit        String?
  categories         String[]            @default([])
  nutriScore         String?
  novaGroup          Int?
  popularity         Int                 @default(0)
  isStaple           Boolean             @default(false)
  /// Produit brut Open Prices vendu au poids (sans code-barres commercial).
  /// Son prix est au kilo et la quantité achetée n'est pas arrondie à un paquet.
  isBulk             Boolean             @default(false)
  isActive           Boolean             @default(true)
  sourceUpdatedAt    DateTime?
  importBatchId      String
  importedAt         DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  prices             OpenFoodPrice[]
  pantryItems        PantryItem[]
  pantryConsumptions PantryConsumption[]

  @@index([normalizedName])
  @@index([isStaple, popularity(sort: Desc)])
  @@index([importBatchId])
}

model OpenFoodPrice {
  id             String          @id @default(cuid())
  productBarcode String
  product        OpenFoodProduct @relation(fields: [productBarcode], references: [barcode], onDelete: Cascade)
  retailer       Retailer
  locationId     Int
  storeName      String?
  price          Decimal         @db.Decimal(10, 2)
  currency       String          @default("EUR")
  observedAt     DateTime        @db.Date
  importBatchId  String
  importedAt     DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([productBarcode, retailer])
  @@index([retailer, productBarcode])
  @@index([importBatchId])
}

model OpenFoodImport {
  id           String    @id
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  productCount Int       @default(0)
  priceCount   Int       @default(0)
  status       String    @default("RUNNING")
  error        String?
}

model NutritionGoal {
  id                String           @id @default(cuid())
  userId            String           @unique
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  caloriesMode      NutrientGoalMode @default(NONE)
  caloriesValue     Decimal?         @db.Decimal(10, 2)
  caloriesTolerance Decimal?         @db.Decimal(10, 2)
  proteinMode       NutrientGoalMode @default(NONE)
  proteinValue      Decimal?         @db.Decimal(10, 2)
  proteinTolerance  Decimal?         @db.Decimal(10, 2)
  carbsMode         NutrientGoalMode @default(NONE)
  carbsValue        Decimal?         @db.Decimal(10, 2)
  carbsTolerance    Decimal?         @db.Decimal(10, 2)
  fatMode           NutrientGoalMode @default(NONE)
  fatValue          Decimal?         @db.Decimal(10, 2)
  fatTolerance      Decimal?         @db.Decimal(10, 2)
  updatedAt         DateTime         @updatedAt
}

model DailyNutritionGoalOverride {
  id                String           @id @default(cuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  date              DateTime         @db.Date
  caloriesMode      NutrientGoalMode
  caloriesValue     Decimal?         @db.Decimal(10, 2)
  caloriesTolerance Decimal?         @db.Decimal(10, 2)
  proteinMode       NutrientGoalMode
  proteinValue      Decimal?         @db.Decimal(10, 2)
  proteinTolerance  Decimal?         @db.Decimal(10, 2)
  carbsMode         NutrientGoalMode
  carbsValue        Decimal?         @db.Decimal(10, 2)
  carbsTolerance    Decimal?         @db.Decimal(10, 2)
  fatMode           NutrientGoalMode
  fatValue          Decimal?         @db.Decimal(10, 2)
  fatTolerance      Decimal?         @db.Decimal(10, 2)

  @@unique([userId, date])
}

model OptimizationPreference {
  id                   String  @id @default(cuid())
  userId               String  @unique
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled              Boolean @default(false)
  allowAutoAdd         Boolean @default(true)
  minPortionMultiplier Decimal @default(0.5) @db.Decimal(4, 2)
  maxPortionMultiplier Decimal @default(2.0) @db.Decimal(4, 2)
}

model OptimizationUndoSnapshot {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromDate  DateTime @db.Date
  toDate    DateTime @db.Date
  payload   Json
  createdAt DateTime @default(now())
}

model UserIngredientFavorite {
  userId       String
  ingredientId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([userId, ingredientId])
}

model UserIngredientRecent {
  userId       String
  ingredientId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  usedAt       DateTime   @default(now()) @updatedAt

  @@id([userId, ingredientId])
  @@index([userId, usedAt])
}
